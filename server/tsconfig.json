{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["**/*.ts", "**/*.js", "**/*.d.ts"],
  "exclude": ["node_modules"]
}